# python / backend
__pycache__/
*.pyc
.pytest_cache/
backend/.env
backend/data/*
# The pre-seeded store ships as a gzip snapshot so a fresh Render boot comes
# up with the full database instead of seeding inside the API process.
!backend/data/seed/
!backend/data/seed/bfi.db.gz
backend/*.log

# virtualenvs
venv/
.venv/
env/
ENV/

# node / next
node_modules/
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo
*.log

# env / secrets
.env
.env.*
!.env.example

# databases (local store lives in backend/data/)
*.db
*.sqlite
*.sqlite3

# OS
Thumbs.db
.DS_Store

# next-on-pages / vercel local cache
.vercel/

